{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.SMABoundless/scopus",
  "description": "Search Scopus abstracts, authors, and export citations via Elsevier API",
  "repository": {
    "url": "https://github.com/SMABoundless/scopus-mcp-server.git",
    "source": "github"
  },
  "version": "1.2.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "scopus-mcp-server",
      "version": "1.2.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Scopus API key from https://dev.elsevier.com/",
          "isRequired": true,
          "isSecret": true,
          "name": "SCOPUS_API_KEY"
        },
        {
          "description": "Optional Elsevier institutional token, for full-view access outside your institution's network",
          "isRequired": false,
          "isSecret": true,
          "name": "SCOPUS_INST_TOKEN"
        }
      ]
    }
  ]
}
